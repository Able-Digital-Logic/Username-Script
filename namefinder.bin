#!/usr/bin/env bash
# namefinder.bin - quick launcher for namefinder.py
#
# Usage:
#   ./namefinder.bin <images_folder> [namefinder.py options...]
#
# Examples:
#   ./namefinder.bin ./screenshots
#   ./namefinder.bin ./screenshots -o ./results --min-conf 50
#   ./namefinder.bin ./screenshots --debug
#
# Runs namefinder.py from whatever directory this launcher lives in,
# regardless of where you call it from.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${PYTHON:-python3}"

if ! command -v "$PY" >/dev/null 2>&1; then
    echo "Error: python3 not found on PATH. Install Python 3 and try again." >&2
    exit 1
fi

if [ "$#" -lt 1 ]; then
    echo "Usage: $(basename "$0") <images_folder> [namefinder.py options...]" >&2
    exit 1
fi

exec "$PY" "$SCRIPT_DIR/namefinder.py" "$@"
